# Copy this file to .env.local and fill in your keys. On Vercel, add the same names as Environment Variables.
# Without GEMINI_API_KEY the app runs in SIMULATION mode (canned opponent + heuristic judge).
# Without a Fish Audio key the app runs silently (text only, typed input).

# --- Gemini (opponent, argument distiller, judge, post-debate report) ---
GEMINI_API_KEY=
# Optional overrides
GEMINI_MODEL=gemini-3.8-flash
GEMINI_JUDGE_MODEL=gemini-3.8-flash

# --- Fish Audio (the AI opponent's voice + speech-to-text for the user's turn) ---
# Up to four team keys. When one runs out of credits, the next one takes over.
# Either list them comma-separated in FISH_AUDIO_API_KEYS, or use the numbered names below.
FISH_AUDIO_API_KEYS=
FISH_AUDIO_API_KEY=
FISH_AUDIO_API_KEY_2=
FISH_AUDIO_API_KEY_3=
FISH_AUDIO_API_KEY_4=
# The custom voice shared by all three opponent difficulties
FISH_AUDIO_OPPONENT_VOICE_ID=
# TTS model sent in the "model" header: s2.1-pro, or s2.1-pro-free while building.
# Must support [bracket] emotion cues (S2 family or a Drama model). Do NOT use s1:
# it only understands (parentheses) cues, so the app strips the emotions for it.
FISH_AUDIO_MODEL=s2.1-pro
# Speech-to-text model for the official transcript
FISH_AUDIO_STT_MODEL=transcribe-1-pro
